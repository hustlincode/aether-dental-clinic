// Prisma schema for Aether Dental - Dental Clinic Booking & Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  RECEPTIONIST
  DENTIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum DentistStatus {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Users (staff accounts with role-based access control)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(RECEPTIONIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activities  Activity[]
  createdAppointments Appointment[] @relation("created_appointments")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

model Patient {
  id             String   @id @default(cuid())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  email          String?
  phone          String
  notes          String?
  status         PatientStatus @default(ACTIVE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([lastName, firstName])
  @@index([status])
  @@unique([email])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Dentists
// ---------------------------------------------------------------------------

model Dentist {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?
  specialization String
  profileImage  String?       @map("profile_image")
  status        DentistStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  appointments Appointment[]
  availability Availability[]
  blockedDates  BlockedDate[]

  @@index([status])
  @@map("dentists")
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model Service {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  durationMin Int           @map("duration_min")
  price       Decimal       @db.Decimal(10, 2)
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("services")
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

model Appointment {
  id              String            @id @default(cuid())
  referenceNumber String            @unique @map("reference_number")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  startTime       String            @map("start_time") // "HH:mm" 24h
  endTime         String            @map("end_time")   // "HH:mm" 24h
  status          AppointmentStatus @default(PENDING)
  notes           String?
  price           Decimal?          @db.Decimal(10, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient    Patient @relation(fields: [patientId], references: [id])
  patientId  String  @map("patient_id")
  dentist    Dentist @relation(fields: [dentistId], references: [id])
  dentistId  String  @map("dentist_id")
  service    Service @relation(fields: [serviceId], references: [id])
  serviceId  String  @map("service_id")
  createdBy  User?   @relation("created_appointments", fields: [createdById], references: [id])
  createdById String? @map("created_by")

  activities Activity[] @relation("appointment_activity")

  @@index([appointmentDate])
  @@index([dentistId, appointmentDate])
  @@index([patientId])
  @@index([status])
  @@index([serviceId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Dentist availability (weekly working schedule + break + blocked dates)
// ---------------------------------------------------------------------------

model Availability {
  id            String    @id @default(cuid())
  dayOfWeek     DayOfWeek @map("day_of_week")
  startTime     String    @map("start_time") // "HH:mm" 24h
  endTime       String    @map("end_time")   // "HH:mm" 24h
  breakStart    String?   @map("break_start")
  breakEnd      String?   @map("break_end")
  isWorking     Boolean   @default(true) @map("is_working")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  dentist   Dentist @relation(fields: [dentistId], references: [id])
  dentistId String  @map("dentist_id")

  @@unique([dentistId, dayOfWeek])
  @@map("availability")
}

// ---------------------------------------------------------------------------
// Blocked dates (dentist-specific or clinic-wide)
// ---------------------------------------------------------------------------

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  dentist   Dentist? @relation(fields: [dentistId], references: [id])
  dentistId String?  @map("dentist_id")

  @@unique([date, dentistId])
  @@index([date])
  @@map("blocked_dates")
}

// ---------------------------------------------------------------------------
// Clinic settings
// ---------------------------------------------------------------------------

model ClinicSetting {
  id              String @id @default("singleton")
  name            String
  address         String?
  phone           String?
  email           String?
  openingTime     String  @map("opening_time") // "09:00"
  closingTime     String  @map("closing_time") // "17:00"
  lunchBreakStart String? @map("lunch_break_start")
  lunchBreakEnd   String? @map("lunch_break_end")
  defaultDurationMin Int  @default(30) @map("default_duration_min")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

// ---------------------------------------------------------------------------
// Activity log
// ---------------------------------------------------------------------------

model Activity {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  description String?
  createdAt DateTime @default(now()) @map("created_at")

  user        User? @relation(fields: [userId], references: [id])
  userId      String? @map("user_id")
  appointment Appointment? @relation("appointment_activity", fields: [appointmentId], references: [id])
  appointmentId String? @map("appointment_id")

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Email log
// ---------------------------------------------------------------------------

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String // SENT | FAILED | SKIPPED
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("email_logs")
}
