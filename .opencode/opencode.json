
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "agent": {
    "architect": {
      "description": "Lead architect and orchestrator for autonomous web application development.",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "jev_*": "allow"
      }
    },
    "developer": {
      "description": "Implements features and fixes bugs.",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "jev_*": "allow"
      }
    },
    "reviewer": {
      "description": "Reviews code quality, correctness, and security.",
      "mode": "subagent",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "jev_*": "allow"
      }
    }
  },
  "mcp": {
    "jev": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "github:codaaiteam/jev-mcp"
      ],
      "environment": {
        "TYPESAFE_API_KEY": "{env:TYPESAFE_API_KEY}"
      },
      "enabled": true
    }
  }
}
