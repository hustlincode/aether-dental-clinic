{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "agent": {
    "architect": {
      "description": "Lead architect and orchestrator for autonomous web application development.",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow"
      }
    }
  }
}
