{
  "name": "aether-dental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node tests/run-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.ts",
    "perf:loading": "node scripts/measure-loading.mjs",
    "perf:notifications": "node scripts/measure-notifications.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:classes": "tsx scripts/audit-classes.mts",
    "cn:build": "node node_modules/cn/bin/cn.mjs build --config cn.config.mjs --full -o src/lib/cn-tables.ts",
    "security:rotate-passwords": "tsx scripts/rotate-staff-passwords.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.8",
    "nodemailer": "^8.0.11",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
